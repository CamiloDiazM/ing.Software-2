<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="co.edu.poli.ejercicio.Controller.MenuController">
    <top>
        <MenuBar>
            <Menu text="Gestión de Productos">
                <MenuItem text="Agregar Producto" onAction="#mostrarAgregarProducto"/>
                <MenuItem text="Reducir Stock" onAction="#ejecutarReducirStock"/>
            </Menu>
            <Menu text="Pedidos">
                <MenuItem text="Calcular Total" onAction="#mostrarCalcularTotal"/>
                <MenuItem text="Procesar Pedido" onAction="#ejecutarProcesarPedido"/>
            </Menu>
            <Menu text="Ayuda">
                <MenuItem text="Acerca de" onAction="#mostrarAcercaDe"/>
            </Menu>
        </MenuBar>
    </top>
    <center>
        <VBox spacing="10" alignment="CENTER">            <GridPane hgap="10" vgap="10">
                <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="nombreField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Precio:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="precioField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Cantidad:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="cantidadField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label text="Stock:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="stockField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                <Button text="Agregar Producto" onAction="#agregarProductoDesdeFormulario" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </GridPane>
            <TableView fx:id="productosTable" prefHeight="300" prefWidth="600">
                <columns>
                    <TableColumn text="Nombre" fx:id="nombreColumn"/>
                    <TableColumn text="Precio" fx:id="precioColumn"/>
                    <TableColumn text="Cantidad" fx:id="cantidadColumn"/>
                    <TableColumn text="Stock" fx:id="stockColumn"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
